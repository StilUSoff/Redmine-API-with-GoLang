# Скопируйте в .env и заполните. .env не коммитится.

# Redmine API (читается main.go)
HOST=http://<VM_HOST>:80
API_Key=<redmine-api-key>

# Виртуальная машина
VM_HOST=<vm-ip>
VM_SSH_PASSWORD=<password>

# Redmine admin
REDMINE_ADMIN_USER=<user>
REDMINE_ADMIN_PASSWORD=<password>

# MySQL
MYSQL_USER=<user>
MYSQL_PASSWORD=<password>
MYSQL_DB=myredminedb
